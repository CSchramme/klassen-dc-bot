# --- Pflicht ---
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=

# --- Optional: Claude für das Ticketsystem ("Gerd") ---
# Ohne Key antwortet Gerd mit vorgefertigten dummen Sprüchen.
ANTHROPIC_API_KEY=
# Modell für Gerd. Standard ist claude-opus-5-5. Günstiger: claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# Wie viele Gerd-Antworten pro Ticket maximal (Kostenbremse)
TICKET_MAX_REPLIES=25

# --- Optional: Soundboard-Chaos ---
# Zufälliger Überfall alle MIN..MAX Minuten (wenn jemand im Sprachkanal ist)
CHAOS_MIN_MINUTES=10
CHAOS_MAX_MINUTES=45
# Wahrscheinlichkeit (0..1), dass der Bot direkt hinterherkommt, wenn jemand einem Sprachkanal beitritt
CHAOS_JOIN_CHANCE=0.25
# Wie viele Sounds pro Besuch
CHAOS_MIN_SOUNDS=1
CHAOS_MAX_SOUNDS=4
# Wenn der Server keine eigenen Soundboard-Sounds hat: Discord-Standardsounds nehmen? (true/false)
CHAOS_DEFAULT_SOUNDS=true

# --- Optional: Quatsch-Moderation ---
# Timeout in Sekunden für das Erwähnen von Gänsen (0 = kein Timeout)
MOD_TIMEOUT_SECONDS=30
