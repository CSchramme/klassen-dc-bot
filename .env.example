# --- Pflicht ---
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=

# --- Optional: KI für das Ticketsystem ("Willy") ---
# Ohne Key antwortet Willy mit vorgefertigten dummen Sprüchen.
# Variante 1 (kostenlos): Google Gemini. Key gibt es auf https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini-Modell. Falls es das nicht mehr gibt, steht das beim Start in der Konsole.
GEMINI_MODEL=gemini-3.8-flash
# Ersatzmodelle (kommagetrennt), falls das Hauptmodell überlastet ist
GEMINI_FALLBACK_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Variante 2 (kostet Guthaben): Claude. Wenn beide Keys drinstehen, gewinnt Claude.
ANTHROPIC_API_KEY=
# Modell für Willy. Standard ist claude-opus-5-5. Günstiger: claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# Wie viele Willy-Antworten pro Ticket maximal (Kostenbremse bzw. Gratis-Limit schonen)
TICKET_MAX_REPLIES=25

# --- Optional: Soundboard-Chaos ---
# Zufälliger Überfall alle MIN..MAX Minuten (wenn jemand im Sprachkanal ist)
CHAOS_MIN_MINUTES=10
CHAOS_MAX_MINUTES=45
# Wahrscheinlichkeit (0..1), dass der Bot direkt hinterherkommt, wenn jemand einem Sprachkanal beitritt
CHAOS_JOIN_CHANCE=0.25
# Wie viele Sounds pro Besuch
CHAOS_MIN_SOUNDS=1
CHAOS_MAX_SOUNDS=4
# Discord-Standardsounds (Quack, Airhorn …) mitbenutzen? Standard: nein, nur die eigenen Sounds des Servers
CHAOS_DEFAULT_SOUNDS=false

# --- Optional: Quatsch-Moderation ---
# Timeout in Sekunden für das Erwähnen von Gänsen (0 = kein Timeout)
MOD_TIMEOUT_SECONDS=30

# --- Optional: Automatischer Unsinn (an/aus per /automatik) ---
ZEITZONE=Europe/Berlin
# Vertretungsplan Mo-Fr um diese Uhrzeit (in #stundenplan-verwirrung)
VERTRETUNGSPLAN_UHRZEIT=07:15
# Namens-Roulette täglich um diese Uhrzeit (nur Leute, die mitmachen)
NAMENSROULETTE_UHRZEIT=07:00
# Durchsagen aus dem Sekretariat alle MIN..MAX Stunden
DURCHSAGE_STUNDEN_MIN=3
DURCHSAGE_STUNDEN_MAX=8
# Willys Putz-Rundgang alle MIN..MAX Stunden
PUTZEN_STUNDEN_MIN=4
PUTZEN_STUNDEN_MAX=10
# Zufälliger Feueralarm alle MIN..MAX Tage (nur wenn mind. 2 Leute im Sprachkanal sind)
FEUERALARM_TAGE_MIN=2
FEUERALARM_TAGE_MAX=7
# Zufällige Sachen nur zwischen diesen Uhrzeiten
AKTIV_VON=8
AKTIV_BIS=21
